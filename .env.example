# ── Backend ─────────────────────────────────────────────────────
APP_ID=schitalka
APP_SECRET=                  # Random secret of at least 64 characters; never commit the real value

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=                # mysql://user:pass@host:port/db; on Railway use the MySQL reference variable

# ── Frontend (only for optional Kimi OAuth) ────────────────────
VITE_KIMI_AUTH_URL=https://auth.kimi.com
VITE_APP_ID=schitalka

# ── Backend (optional Kimi OAuth endpoints) ────────────────────
KIMI_AUTH_URL=https://auth.kimi.com
KIMI_OPEN_URL=https://open.kimi.com

# ── First teacher ──────────────────────────────────────────────
# Set this BEFORE registering the teacher. For login "Teacher" use student:teacher.
OWNER_UNION_ID=student:teacher

# ── Homework files (Railway Volume; only metadata is stored in MySQL) ──
# The directory must be inside the mounted Volume. Never use a repository path.
UPLOAD_DIR=/data/homework

# ── Optional, teacher-triggered AI checks (server-side only) ─────
MOONSHOT_API_KEY=              # Never expose the real key to the browser or GitHub
MOONSHOT_MODEL=                # Select a model available to your Moonshot account
# Paid calls never start automatically. Zero disables all new AI checks.
AI_MONTHLY_LIMIT=0
